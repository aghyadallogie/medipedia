{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [".env*"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "PAYLOAD_SECRET",
        "JWT_SECRET",
        "BLOB_READ_WRITE_TOKEN",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET",
        "GOOGLE_MOBILE_CLIENT_IDS",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "UPSTASH_REDIS_REST_URL",
        "UPSTASH_REDIS_REST_TOKEN",
        "REQUIRE_EMAIL_CONFIRMATION",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_CONTACT_EMAIL",
        "VERCEL_ENV"
      ]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "PAYLOAD_SECRET",
        "JWT_SECRET",
        "NEXT_PUBLIC_SITE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"],
      "passThroughEnv": ["DATABASE_URL", "PAYLOAD_SECRET", "NEXT_PUBLIC_SITE_URL", "JWT_SECRET"]
    },
    "test:int": {
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "DATABASE_URL_UNPOOLED",
        "PAYLOAD_SECRET",
        "NEXT_PUBLIC_SITE_URL",
        "JWT_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
