# Copy to .env and fill in. Never commit .env. See AGENTS.md §11.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Phase 1 (required) ---
# Local dev: `pnpm db:up` starts Postgres from docker-compose.yml with these values.
# Neon: DATABASE_URL is the pooled string, DATABASE_URL_UNPOOLED the direct one.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/medipedia
DATABASE_URL_UNPOOLED=postgres://postgres:postgres@127.0.0.1:5432/medipedia
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Phase 2 (media uploads) ---
BLOB_READ_WRITE_TOKEN=

# --- Phase 4 (learner auth, email) ---
# Required. Signs learner access tokens, so it must differ from PAYLOAD_SECRET.
JWT_SECRET=
# Optional: Google sign-in is switched on when both are set. In Google Cloud, add this redirect URI:
#   <NEXT_PUBLIC_SITE_URL>/api/v1/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: extra Google client IDs (iOS, Android) accepted by the mobile endpoint, comma-separated.
GOOGLE_MOBILE_CLIENT_IDS=
# Optional locally (emails are printed to the console). Required on Vercel preview and production.
RESEND_API_KEY=
EMAIL_FROM=

# --- Phase 7 (rate limiting) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
