{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./base.json",
  "compilerOptions": {
    // DOM libs are for global types such as URL and URLSearchParams that exist in Node,
    // browsers and React Native. Nothing here touches the DOM itself.
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  }
}
